# What an editor should do with the files in this repository, whatever editor
# that is -- VS Code, PyCharm, Vim, Emacs, Sublime and the rest read this file.
# Every setting below is the one the tree is already written in, not a
# preference being imposed on it.
#
# Line endings are the half of this that matters: a file saved with CRLF comes
# back as a whole-file diff to everyone else, and a CRLF shell script will not
# run on Linux. Git cannot see an editor's settings, so this file is paired
# with `.gitattributes`, which makes git normalize what it stores; this is what
# an editor is told before it writes.
#
# Measured rather than assumed, when this was written: every tracked file has
# LF in the index and no tracked file contains a tab.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown; trimming them would
# join lines that are meant to be apart.
trim_trailing_whitespace = false
